# LLM provider
LLM_MODEL=openai/gemini-2.5-flash
LLM_API_KEY=
LLM_API_BASE=https://1xai.ir/v1

# Optional legacy key name used by the original project
XAI_1_API_KEY=

# LLM request configuration
LLM_TEMPERATURE=0
LLM_TIMEOUT=60

# Agent configuration
AGENT_MAX_STEPS=10
TOOL_TIMEOUT=30

# Logging: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO