# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------

# Any model string that LiteLLM understands. The "openai/" prefix means the
# request goes to an OpenAI-compatible endpoint (see LLM_API_BASE below).
LLM_MODEL=openai/gemini-2.5-flash

# Required. Without it the CLI exits immediately.
LLM_API_KEY=

# OpenAI-compatible endpoint. Set this only when you are NOT calling the
# provider's official API (self-hosted gateway, proxy, aggregator, ...).
# Example third-party gateway: https://1xai.ir/v1
# Leave empty to use the provider's default endpoint.
LLM_API_BASE=

# Deprecated alias for LLM_API_KEY, kept for backwards compatibility.
XAI_1_API_KEY=

# ---------------------------------------------------------------------------
# LLM request configuration
# ---------------------------------------------------------------------------
LLM_TEMPERATURE=0
LLM_TIMEOUT=60

# ---------------------------------------------------------------------------
# Agent configuration
# ---------------------------------------------------------------------------
AGENT_MAX_STEPS=10
AGENT_MAX_CONTEXT_CHARS=120000
TOOL_TIMEOUT=30

# ---------------------------------------------------------------------------
# Logging: DEBUG, INFO, WARNING, ERROR, CRITICAL
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
