# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------

# Required. Any model string that LiteLLM understands, for example:
#   ollama_chat/qwen2.5:3b    (local Ollama)
#   gemini/gemini-2.5-flash   (Google Gemini)
# The model is configured only here; there is no default in the code.
LLM_MODEL=ollama_chat/qwen2.5:3b

# Required. The CLI checks this before starting the MCP server.
# For a local Ollama server any non-empty value works (for example: ollama).
LLM_API_KEY=ollama

# Optional OpenAI-compatible or local base URL.
# Local Ollama: use 127.0.0.1 instead of localhost (avoids a connection
# delay on Windows). Leave empty for official cloud APIs.
LLM_API_BASE=http://127.0.0.1:11434

# Deprecated alias for LLM_API_KEY, kept for backwards compatibility.
XAI_1_API_KEY=

# ---------------------------------------------------------------------------
# LLM request configuration
# ---------------------------------------------------------------------------
LLM_TEMPERATURE=0

# Seconds per LLM request. A local model needs extra time for its first
# (cold) load, so use 180 or more with Ollama; 60 is enough for cloud APIs.
LLM_TIMEOUT=180

# ---------------------------------------------------------------------------
# Agent configuration
# ---------------------------------------------------------------------------
# System prompt profile: "default" (general assistant) or "finance" (adds
# rules for news, markets, forex and live prices: search first, no invented
# numbers, cite sources and timestamps).
SYSTEM_PROMPT_PROFILE=default

AGENT_MAX_STEPS=10
AGENT_MAX_CONTEXT_CHARS=120000
TOOL_TIMEOUT=30

# ---------------------------------------------------------------------------
# Logging: DEBUG, INFO, WARNING, ERROR, CRITICAL
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
