# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------

# Any model string that LiteLLM understands. The default uses LiteLLM's
# native Gemini provider. For OpenAI-compatible gateways, choose a compatible
# model string and configure LLM_API_BASE below.
LLM_MODEL=gemini/gemini-2.5-flash

# Required. The CLI checks this before starting the MCP server.
LLM_API_KEY=

# OpenAI-compatible endpoint. Set this only when you are NOT calling the
# provider's official API (self-hosted gateway, proxy, aggregator, ...).
# Set this only for an OpenAI-compatible gateway or self-hosted endpoint.
# Leave empty to use the selected provider's default endpoint.
LLM_API_BASE=

# Deprecated alias for LLM_API_KEY, kept for backwards compatibility.
XAI_1_API_KEY=

# ---------------------------------------------------------------------------
# LLM request configuration
# ---------------------------------------------------------------------------
LLM_TEMPERATURE=0
LLM_TIMEOUT=60

# ---------------------------------------------------------------------------
# Agent configuration
# ---------------------------------------------------------------------------
AGENT_MAX_STEPS=10
AGENT_MAX_CONTEXT_CHARS=120000
TOOL_TIMEOUT=30

# ---------------------------------------------------------------------------
# Logging: DEBUG, INFO, WARNING, ERROR, CRITICAL
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
